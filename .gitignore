# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local save copies, uploads, and a copy taken while the DS has the .sav open
/data/saves/*
/data/uploads/*
/data/staging/*
/data/config.json
/data/server.log
/data/server.pid
/data/world-map.jpg
/data/world-map.jpg.part
!/data/saves/.gitkeep
!/data/uploads/.gitkeep
!/data/staging/.gitkeep
