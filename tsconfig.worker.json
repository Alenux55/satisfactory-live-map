{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".next/parse-worker",
    "rootDir": "src/lib/world",
    "declaration": false,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src/lib/world/parse-worker.ts"]
}
