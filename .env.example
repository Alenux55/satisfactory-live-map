# Sidecar on the Windows dedicated server. Copy to .env.local (not committed).
# next start already binds 0.0.0.0:43147 so other PCs on the LAN can open the map.

HOSTNAME=0.0.0.0
PORT=43147

# Seeds the first dedicated-server entry in the sidebar catalog.
# Add more save folders in the UI if you run several dedicated servers.
# Demo factory is always available as its own catalog item.
FICSIT_SAVES_DIR=%LOCALAPPDATA%/FactoryGame/Saved/SaveGames/server
FICSIT_MODE=watch

# Match in-game autosave. 300 = 5 minutes. Do not use 5s on the game box.
FICSIT_POLL_SECONDS=300

# info = parse/delta only. debug = ticks, HTTP, parse %, SSE.
FICSIT_LOG=info
# FICSIT_LOG_FILE=data/server.log

# Optional: pin one session instead of newest .sav in the folder
# FICSIT_SAVE_FILE=C:/Users/Administrator/AppData/Local/FactoryGame/Saved/SaveGames/server/Session.sav
